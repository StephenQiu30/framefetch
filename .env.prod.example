# Copy to .env.prod only when it does not exist. Never copy local credentials.
# Start with both Compose files and --env-file .env.prod; see README.md.
APP_ENV=production
FRONTEND_BUILD_TARGET=runtime
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=8111
FRONTEND_HOST_PORT=8101
SITE_URL=https://replace-with-public-host
SITE_INDEXABLE=false
# Add the exact Docker ingress gateway /32 when a host reverse proxy connects
# through published API ports (inspect the actual app_net gateway).
TRUSTED_PROXY_CIDRS=["127.0.0.0/8","::1/128"]
FRONTEND_IPV4_ADDRESS=10.251.0.10
APP_NETWORK_SUBNET=10.251.0.0/24
APP_NETWORK_IP_RANGE=10.251.0.128/25

# Existing infrastructure: use its real addresses, ports and credentials.
# For docker-compose-env.yml on Linux, bind published infrastructure ports to
# the Docker host gateway (commonly 172.17.0.1), never to a public interface.
INFRA_HOST_BIND=127.0.0.1
HOST_POSTGRES_PORT=15432
HOST_RABBITMQ_PORT=5673
HOST_RABBITMQ_MANAGEMENT_PORT=15673
HOST_REDIS_PORT=16380
HOST_MINIO_PORT=19190
HOST_MINIO_CONSOLE_PORT=19191
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=15432
POSTGRES_DB=framefetch
POSTGRES_USER=framefetch
POSTGRES_PASSWORD=
# Host CLI / AI Worker URL; Compose constructs its own container connection URL.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${INFRA_HOST_BIND}:${POSTGRES_PORT}/${POSTGRES_DB}
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5673
RABBITMQ_DEFAULT_USER=framefetch-admin
RABBITMQ_DEFAULT_PASS=
RABBITMQ_VHOST=framefetch
RABBITMQ_API_USER=framefetch-api
RABBITMQ_API_PASS=
RABBITMQ_WORKER_USER=framefetch-worker
RABBITMQ_WORKER_PASS=
RABBITMQ_DLQ_USER=framefetch-dlq
RABBITMQ_DLQ_PASS=
REDIS_HOST=host.docker.internal
REDIS_PORT=16380
MINIO_HOST=host.docker.internal
MINIO_PORT=19190
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=framefetch-artifacts
MINIO_PUBLIC_ENDPOINT=replace-with-public-storage-host
MINIO_PUBLIC_SECURE=true
MINIO_INTERNAL_SECURE=false
MINIO_CORS_ALLOWED_ORIGINS=https://replace-with-public-host
MINIO_LOCAL_BROWSER_ENDPOINT=
MINIO_LOCAL_BROWSER_SECURE=false

AUTH_WEB_COOKIE_NAME=framefetch_web_session
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_SECRET=
AUTH_JWT_SECRET=
REQUEST_FINGERPRINT_SECRET=
URL_ENCRYPTION_KEY=
RUNNER_HMAC_SECRET=
METRICS_ACCESS_KEY=

TEMPORAL_HOST=host.docker.internal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=framefetch
TEMPORAL_ADDRESS=${INFRA_HOST_BIND}:${TEMPORAL_PORT}
DOWNLOAD_WORKER_THREADS=2
SESSION_RUNNER_MAX_ACTIVE_TASKS=2
ANALYSIS_ENABLED=false
SCREENPLAY_ANALYSIS_ENABLED=false
ANALYSIS_DATABASE_URL=${DATABASE_URL}
ANALYSIS_MINIO_ENDPOINT=${INFRA_HOST_BIND}:${MINIO_PORT}
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Configure a real fixed residential upstream before accepting global media.
EGRESS_CN_UPSTREAM_HOST=
EGRESS_CN_UPSTREAM_PORT=7897
EGRESS_GLOBAL_UPSTREAM_HOST=
EGRESS_GLOBAL_UPSTREAM_PORT=7898
EGRESS_FALLBACK_UPSTREAM_HOST=host.docker.internal
EGRESS_FALLBACK_UPSTREAM_PORT=7897
EGRESS_NODE_REVISION=1
