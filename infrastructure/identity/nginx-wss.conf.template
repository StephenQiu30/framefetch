# Include inside the existing TLS server. Preserve its valid certificate.
location = /identity/extension {
    if ($is_args != "") { return 404; }
    if ($http_origin != "${EXTENSION_ORIGIN}") { return 403; }
    limit_conn framefetch_identity_connections 2;
    limit_req zone=framefetch_identity_handshakes burst=4 nodelay;
    limit_req_status 429;
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://127.0.0.1:19101/extension;
    proxy_http_version 1.1;
    proxy_set_header Host localhost;
    proxy_set_header Origin $http_origin;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 2s;
    proxy_read_timeout 65s;
    proxy_send_timeout 35s;
    proxy_buffering off;
}
location = /identity { return 404; }
location /identity/ { return 404; }
