# Include in Nginx http context. Render placeholders before enabling.
limit_conn_zone $binary_remote_addr zone=framefetch_identity_connections:1m;
limit_req_zone $binary_remote_addr zone=framefetch_identity_handshakes:1m rate=6r/m;

# Only Squid's uplink network can reach this listener; Bearer is still required.
server {
    listen ${DOCKER_HOST_GATEWAY}:19101;
    server_name _;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 4096;
    client_body_timeout 2s;
    allow ${SQUID_UPLINK_CIDR};
    deny all;

    location ~ ^/(cookies|yuanbao-parse|identity-result)$ {
        if ($request_method != POST) { return 404; }
        if ($is_args != "") { return 404; }
        proxy_pass http://127.0.0.1:19101;
        proxy_set_header Host localhost;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 35s;
        proxy_connect_timeout 2s;
    }
    location / { return 404; }
}
